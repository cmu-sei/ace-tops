# DM26-0670

# infra/under-test/gitlab/under-test.nuon
#
# The test GitLab, a configuration under test (docs/architecture/configurations-under-test.md, CT3): GitLab CE in its own
# namespace, its server certificate from the credentials agent as Neo4j's is, and a runner with the Kubernetes executor, for the
# GitLab pair's live run (docs/architecture/http-observers.md, "GitLab", G4). A cluster carries it with `up.nu <target>
# --under-test gitlab`.
{
  adds: {
    cluster: {
      # Its pods are attested as Polar's are, and its server is on the floor, vouched for by the credentials agent.
      attest_also: ["gitlab-test"]
      issuance: {
        server_also: [
          { namespace: "gitlab-test", service_account: "gitlab", names: ["gitlab.gitlab-test.svc.cluster.local" "gitlab.gitlab-test.svc" "gitlab.gitlab-test" "gitlab"] }
        ]
      }
    }
    # The GitLab pair, which sandbox-local leaves out: run under test, marked. The observer trusts the cluster's CA, the file every
    # pod has, since the test GitLab's certificate is the credentials agent's (docs/architecture/egress.md, "The cluster's own CA").
    workloads: {
      gitlab-observer: { enabled: true, env: [{ name: "POLAR_EGRESS_CLUSTER_CA", value: "/etc/polar-ca/ca.pem" }] }
      gitlab-processor: { enabled: true }
    }
  }
  layer: {
    files: [
      "gitlab-test.yaml"
      # The GitLab pair it enables, rendered by the catalog.
      "gitlab-observer-resources.yaml"
      "gitlab-observer.yaml"
      "gitlab-processor-resources.yaml"
      "gitlab-processor.yaml"
    ]
    # Its ready script needs GitLab answering; the runner waits for the token that script gives it.
    wait_for: [{ kind: "statefulset", ns: "gitlab-test", ref: "statefulset/gitlab", label: "gitlab" }]
  }
  # The root password, a generated Secret in the cluster only.
  secrets: "secrets.nu"
  # Once GitLab answers: root's token, for the seed and the observer, and the runner's registration.
  ready: "ready.nu"
  # Named in the runner's config.toml, not on an `image:` line: the job's image and the executor's helper.
  images: ["busybox:latest" "gitlab-runner-helper:alpine3.21-v19.5.3"]
}
