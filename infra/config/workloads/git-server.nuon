# DM26-0670

# infra/config/workloads/git-server.nuon
#
# The Polar git server: hosts the configuration repositories (the schedules repo first) over git
# smart HTTP, authenticating every caller by its mTLS certificate. A PolarAgent: it says in its own
# code what it requires and how long it drains (`polar-git-server --scaffold`); the entry says what
# the deployment gives it and which repositories it hosts. Design: docs/architecture/git-server.md.
[
  {
    name: "polar-git-server"
    kind: "agent"
    # Its node pool, where a target declares placement (docs/architecture/placement.md).
    pool: "core"
    image: "polar-git-server"
    config: "document"
    # The repositories and the store's logs are history that must survive the pod (persistent-data); the rest is its
    # listener certificate and paths (git-server). Its logs' checkpoint key (`checkpoints`) it requires itself.
    provides: ["git-server", "persistent-data"]
    # What the git CLI connects to. Reached by port-forward in development; never terminated.
    service: {
      name: "{polar-git-server.name}"
      ports: [ { name: "git-https", port: "{polar-git-server.port}" } ]
    }
    # The repositories it creates (and seeds, once) at start, and who may read and write each. polar-evidence holds
    # evidence records, each signed by the collector that made it (docs/architecture/http-observers.md, "Evidence"); the
    # attestation agent adds its own over Cassini (docs/architecture/record-store.md, "Bite 3"), the credentials agent its
    # revocations (docs/architecture/key-custody.md, "Revocations as evidence"), and people theirs with git, as the
    # administrators grant.
    # Identities are the DNS SANs of the callers' certificates; a workload's is
    # <serviceaccount>.<namespace>.serviceaccount.<cluster domain> (cert-issuer's normalisation).
    env: [
      {
        name: "POLAR_GIT_SERVER_REPOS"
        value: '{"admins":[],"repos":[{"name":"polar-schedules","readers":["polar-scheduler-observer.polar.serviceaccount.cluster.local"],"writers":[],"seed":"polar-schedules"},{"name":"polar-evidence","readers":[],"writers":["attestation-agent.polar.serviceaccount.cluster.local","credentials-agent.polar.serviceaccount.cluster.local"],"seed":"polar-evidence"},{"name":"deployment","readers":["deployment:flux","polar-scheduler-observer.polar.serviceaccount.cluster.local"],"writers":[],"signed_by":{"ca":"/etc/polar-deploy-ca/ca.pem","signer":"pipeline"}}]}'
      }
    ]
  }
]
