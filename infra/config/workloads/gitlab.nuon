# DM26-0670

# infra/config/workloads/gitlab.nuon
#
# The GitLab pair on the HTTP observer library (docs/architecture/http-observers.md, "GitLab"). The observer reads the GraphQL sources
# its signed `sources` section names, with the token its signed `credentials` section escrows; the processor writes what it reads to
# the graph by its signed `projection` section. Neither is given anything here: with no section signed the observer reads nothing,
# and the processor holds and says so. No target runs it yet: the test GitLab's configuration under test enables it
# (infra/under-test/gitlab/), so it runs under test.
[
  {
    name: "gitlab-observer"
    kind: "agent"
    # It reads what its sources name and holds no graph password: the low-trust side (docs/architecture/placement.md).
    pool: "observers"
    image: "gitlab-observer"
    config: "document"
  }

  {
    name: "gitlab-processor"
    kind: "agent"
    pool: "writers"
    image: "gitlab-processor"
    config: "document"
  }
]
