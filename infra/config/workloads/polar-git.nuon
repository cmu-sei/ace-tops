# DM26-0670

# infra/config/workloads/polar-git.nuon
#
# polar-git: people's source code over git smart HTTP, the one service inside the boundary that people connect to
# directly, every git operation judged by Cedar policy and reported over Cassini. A PolarAgent: it says in its own code
# what it requires and how long it drains (`polar-git --scaffold`). Design: docs/architecture/polar-git.md.
[
  {
    name: "polar-git"
    kind: "agent"
    pool: "core"
    image: "polar-git"
    config: "document"
    # People's repositories are history that must survive the pod (persistent-data); the rest is its listener certificate
    # and paths (source-git).
    provides: ["source-git", "persistent-data"]
    # What git, through git-remote-polar, connects to. Reached by port-forward in development; never terminated.
    service: {
      name: "{polar-git.name}"
      ports: [ { name: "git-https", port: "{polar-git.port}" } ]
    }
  }
]
