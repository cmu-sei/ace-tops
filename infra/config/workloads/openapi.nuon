# DM26-0670

# infra/config/workloads/openapi.nuon
#
# The OpenAPI agents, the first of the HTTP observers (docs/architecture/http-observers.md). The observer reads the
# documents its signed `sources` section names and publishes them; the processor writes them to the graph by its signed
# `projection` section, inside the schema it was built with. Neither is given anything here: with no section signed the
# observer reads nothing, and the processor holds and says so.
[
  {
    name: "openapi-observer"
    kind: "agent"
    # It reads whatever its sources name and holds no graph password: the low-trust side (docs/architecture/placement.md).
    pool: "observers"
    image: "openapi-observer"
    config: "document"
  }

  {
    name: "openapi-processor"
    kind: "agent"
    pool: "writers"
    image: "openapi-processor"
    config: "document"
  }
]
