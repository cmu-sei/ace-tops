# DM26-0670

# infra/config/workloads/attestation.nuon
#
# The attestation agent (docs/architecture/runtime-attestation.md): it sees the pods of Polar's namespaces and answers whether an instance is what
# the deployment made. It is not in the core; it starts after it, and an asker issues without it until it is up.
[
  {
    name: "attestation-agent"
    kind: "agent"
    # Beside the identities it guards; it holds a read view of every Polar pod, and `observers` is the low-trust side
    # (the maintainer, 2026-11-02).
    pool: "core"
    image: "attestation-agent"
    config: "document"
    provides: ["deployment-ca"]
    env: [
      { name: "POLAR_ATTESTATION_NAMESPACES", value: "{attested-namespaces}" }
    ]
  }
]
